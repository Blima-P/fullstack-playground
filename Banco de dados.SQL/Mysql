CREATE DATABASE BibliotecaDB4;
USE BibliotecaDB4;
CREATE TABLE Autores(
	autor_id int NOT NULL primary key,
	nome VARCHAR(100) NOT NULL,
	nacionalidade VARCHAR(50)
);
CREATE TABLE Editoras(
	editora_id int primary key,
	nome VARCHAR(50) NOT NULL UNIQUE,
	cidade VARCHAR (100)
);
CREATE TABLE livros(
	livro_id int, 
	titulo VARCHAR(255) not null,
	ano_publicacao int,
	autor_id int,
	editora_id int,
primary key (livro_id),
CONSTRAINT fk_livro_autor FOREIGN KEY (autor_id) REFERENCES Autores(autor_id),
CONSTRAINT fk_livro_editora FOREIGN KEY (editora_id) REFERENCES Editoras(editora_id)
);
CREATE TABLE livros_antigos
	(id INT);
